# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# OpenAI vision-language model, used by data/prepare/detect_mit_openai.py to
# produce open-vocabulary object labels for each scene image.
OPENAI_KEY=

# Optional: MinIO object store, only for mirroring large derived artifacts
# (extracted features, item-graph caches). Not needed to run the pipeline.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=true
